{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stardust.dev/schemas/coverage-pages.schema.json",
  "title": "stardust coverage/pages.json",
  "description": "Campaign-level coverage projection over state.json.pages[]. Rolls up generation depth, optimize findings, content mode, and per-target delivery so the orchestrator and dashboard can answer done-vs-missing without re-deriving. Owned by stardust:site; narrow fields written back by the phase that owns them.",
  "type": "object",
  "required": ["_provenance", "pages"],
  "additionalProperties": false,
  "properties": {
    "_provenance": { "$ref": "#/$defs/provenance" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "pages": {
      "type": "array",
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["writtenBy", "writtenAt", "stardustVersion"],
      "properties": {
        "writtenBy": { "type": "string", "examples": ["stardust:site"] },
        "writtenAt": { "type": "string", "format": "date-time" },
        "readArtifacts": { "type": "array", "items": { "type": "string" } },
        "synthesizedInputs": { "type": "array", "items": { "type": "string" } },
        "stardustVersion": { "type": "string" }
      }
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6,
      "description": "Depth ladder. 0 discovered, 1 extracted, 2 directed, 3 prototyped, 4 optimized, 5 migrated, 6 delivered. Projection over state.json status strings; the deepest rung reached."
    },
    "page": {
      "type": "object",
      "required": ["slug", "url", "depth"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "templateId": {
          "type": ["string", "null"],
          "description": "The template that governs this page's redesign. References coverage/templates.json[].id. Null until typed at D2."
        },
        "depth": { "$ref": "#/$defs/depth" },
        "depthHistory": {
          "type": "array",
          "description": "Mirror of state.json history, projected to the depth axis.",
          "items": {
            "type": "object",
            "required": ["depth", "at"],
            "properties": {
              "depth": { "$ref": "#/$defs/depth" },
              "at": { "type": "string", "format": "date-time" },
              "batchId": { "type": "string" }
            }
          }
        },
        "approved": {
          "type": "boolean",
          "description": "Sub-flag on D3: the user explicitly approved this page's prototype.",
          "default": false
        },
        "stale": { "type": "boolean", "default": false },
        "staleReason": { "type": ["string", "null"] },
        "contentMode": {
          "type": "string",
          "enum": ["verbatim", "optimized"],
          "default": "verbatim",
          "description": "Content fidelity dial. verbatim preserves copy/images exactly; optimized allows bounded, audit-justified, logged edits."
        },
        "batchId": {
          "type": ["string", "null"],
          "description": "The iteration batch that brought this page to its current depth."
        },
        "optimize": {
          "type": "object",
          "description": "Rollup of optimize/findings.json scoped to this page.",
          "additionalProperties": false,
          "properties": {
            "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
            "findings": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "total": { "type": "integer", "minimum": 0 },
                "P1": { "type": "integer", "minimum": 0 },
                "P2": { "type": "integer", "minimum": 0 },
                "P3": { "type": "integer", "minimum": 0 },
                "open": { "type": "integer", "minimum": 0 },
                "fixed": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "delivery": {
          "type": "object",
          "description": "Per-target delivery overlay, filled by deploy. Keyed implicitly by the active target; one object for the single-target-for-now model.",
          "additionalProperties": false,
          "properties": {
            "target": { "type": "string", "examples": ["aem-eds"] },
            "status": {
              "type": "string",
              "enum": ["pending", "converting", "deployed", "verified", "failed"]
            },
            "deployedUrl": { "type": ["string", "null"], "format": "uri" },
            "verifiedAt": { "type": ["string", "null"], "format": "date-time" }
          }
        }
      }
    }
  }
}
