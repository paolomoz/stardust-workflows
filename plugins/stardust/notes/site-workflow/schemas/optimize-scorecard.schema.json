{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stardust.dev/schemas/optimize-scorecard.schema.json",
  "title": "stardust optimize/scorecard.json",
  "description": "Site-health scorecard: 7 dimensions each 0-100, an overall health 0-100, severity mix, uplift headroom, and a history[] so the dashboard can chart the score climbing across iterations. Written by stardust:optimize.",
  "type": "object",
  "required": ["_provenance", "current", "history"],
  "additionalProperties": false,
  "properties": {
    "_provenance": { "$ref": "#/$defs/provenance" },
    "current": { "$ref": "#/$defs/snapshot" },
    "history": {
      "type": "array",
      "description": "Append-only prior snapshots (one per optimize run that changed the score).",
      "items": { "$ref": "#/$defs/snapshot" }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["writtenBy", "writtenAt", "stardustVersion"],
      "properties": {
        "writtenBy": { "type": "string", "examples": ["stardust:optimize"] },
        "writtenAt": { "type": "string", "format": "date-time" },
        "stardustVersion": { "type": "string" }
      }
    },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "snapshot": {
      "type": "object",
      "required": ["runId", "at", "overall", "dimensions", "severity"],
      "additionalProperties": false,
      "properties": {
        "runId": { "type": "string", "description": "optimize/findings.json runs[].id this snapshot corresponds to." },
        "at": { "type": "string", "format": "date-time" },
        "overall": { "$ref": "#/$defs/score", "description": "Overall site health 0-100." },
        "headroom": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "Uplift headroom — how much improvement the redesign can deliver."
        },
        "dimensions": {
          "type": "object",
          "description": "Per-layer health 0-100 (one key per detection layer).",
          "additionalProperties": false,
          "required": [
            "brand-tensions",
            "design-ux",
            "accessibility",
            "seo",
            "content-conversion",
            "ai-search",
            "cross-page"
          ],
          "properties": {
            "brand-tensions": { "$ref": "#/$defs/score" },
            "design-ux": { "$ref": "#/$defs/score" },
            "accessibility": { "$ref": "#/$defs/score" },
            "seo": { "$ref": "#/$defs/score" },
            "content-conversion": { "$ref": "#/$defs/score" },
            "ai-search": { "$ref": "#/$defs/score" },
            "cross-page": { "$ref": "#/$defs/score" }
          }
        },
        "severity": {
          "type": "object",
          "description": "Open-finding counts by priority at snapshot time.",
          "additionalProperties": false,
          "properties": {
            "P1": { "type": "integer", "minimum": 0 },
            "P2": { "type": "integer", "minimum": 0 },
            "P3": { "type": "integer", "minimum": 0 }
          }
        },
        "fixed": {
          "type": "object",
          "description": "Cumulative fixed-finding counts by priority (drives the burn-down).",
          "additionalProperties": false,
          "properties": {
            "P1": { "type": "integer", "minimum": 0 },
            "P2": { "type": "integer", "minimum": 0 },
            "P3": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
